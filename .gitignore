# Source repos (merged into lifeos-core)
lifeos-rust-mcp/
lifeos-sync/
/target/
debug/
release/
deps/
incremental/
*.rlib
*.d
*.pdb

# Environment files (NEVER commit these)
.env
.env.*
.envrc
*.env

# Config with secrets (don't commit actual config)
lifeos.config.json
*.config.json
# ...but DO track the embedded default config (compile-time fallback)
!lifeos.config.default.json

# OS files
.DS_Store
Thumbs.db
*~

# Editor
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Vault data
/vault/
*.md.bak
*.md.orig

# Logs
*.log
logs/

# Optional local overrides
.local/.contexty
.memsearch
.hive

# Metadata directories (AI agent session data, tool calls, plans)
.hive/
.memsearch/
.contexty/
.sisyphus/

# tool-state (never commit)
.cortexkit/
.contexty/
