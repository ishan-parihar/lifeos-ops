{
  "apiVersion": "2025-09-03",
  "rateLimit": {
    "requestsPerSecond": 3.0,
    "cacheTtlSeconds": 300
  },
  "holonic": {
    "version": "4.1",
    "architecture": "consciousness-prosthetic",
    "layers": {
      "teleological_pull": {
        "dbs": ["trajectory"],
        "description": "Articulate + simulate the drive toward the ideal-future"
      },
      "historical_record": {
        "dbs": ["logbook", "synthesis", "profile"],
        "description": "Keep tabs on history + current-trajectory/trends"
      },
      "action_interface": {
        "dbs": ["trajectory", "context"],
        "description": "Tell the user what to do + how"
      }
    },
    "flows": {
      "pull": "Trajectory → (parent/child hierarchy) → daily actions",
      "ground_truth": "Action → Logbook → Synthesis → Profile",
      "feedback": "Profile → Trajectory (gap informs pull)"
    },
    "cycle": "Trajectory → Logbook → Synthesis → Profile → Trajectory",
    "status_progressions": {
      "trajectory": ["Future", "Ideation", "Paused", "Active", "Done", "Cancelled"],
      "logbook": [],
      "synthesis": ["💡 Identified", "✅ Activated", "🏆 Capitalized", "🧊 Archived"],
      "profile": ["Draft", "Active", "Evolving", "Archived"],
      "context": ["Active", "Inactive", "Archived"]
    },
    "yaml_schemas_path": "schemas"
  },
  "databases": {
    "trajectory": {
      "name": "Trajectory",
      "data_source_id": "00000000-0000-0000-0000-000000000001",
      "archetype": "trajectory",
      "layer": "teleological_pull",
      "entry_type_property": "Item Type",
      "description": "The teleological hierarchy. The pull IS the parent/child tree. 3 layers: Reference (Purpose/Value/Principle/Vision-Statement/Identity-Statement), Strategic (Annual-Goal/Quarterly-Goal/Milestone), Execution (Project/Task/Campaign/Content/System/Resource/Sprint/Budget)."
    },
    "logbook": {
      "name": "Logbook",
      "data_source_id": "00000000-0000-0000-0000-000000000002",
      "archetype": "logbook",
      "layer": "historical_record",
      "entry_type_property": "Entry Type",
      "description": "Objective ground-reality capture. 6 channels: Activity (Body), Diet (Body), Financial (Resource), Subjective (Mind), Relational (Relational), Systemic (Mind)."
    },
    "synthesis": {
      "name": "Synthesis",
      "data_source_id": "00000000-0000-0000-0000-000000000003",
      "archetype": "synthesis",
      "layer": "historical_record",
      "entry_type_property": "Category",
      "description": "Where logs become insights. Polar structure: Note (neutral), Opportunity/Strength (+), Directive/Risk (−)."
    },
    "profile": {
      "name": "Profile",
      "data_source_id": "00000000-0000-0000-0000-000000000004",
      "archetype": "profile",
      "layer": "historical_record",
      "entry_type_property": "Entry Type",
      "description": "The cumulative state mirror. RPG status report across all dimensions. Trait/Metric/Capacity/Asset. Bridge between history and the pull — shows the GAP."
    },
    "context": {
      "name": "Context",
      "data_source_id": "00000000-0000-0000-0000-000000000005",
      "archetype": "context",
      "layer": "action_interface",
      "entry_type_property": "Type",
      "description": "The environment. Person (14 CRM props), Community, Organization, Financial-Account, Place."
    }
  },
  "briefings": {
    "roles": {
      "CEO": [
        { "db": "trajectory", "intent": "vision alignment", "limit": 5, "date_filter": false },
        { "db": "trajectory", "intent": "active annual goals", "limit": 5, "date_filter": false }
      ],
      "COO": [
        { "db": "trajectory", "intent": "active projects", "limit": 10, "date_filter": false },
        { "db": "profile", "intent": "current traits", "limit": 10, "date_filter": false }
      ]
    },
    "modules": {
      "productivity": [
        { "db": "trajectory", "intent": "active tasks", "limit": 20, "date_filter": true }
      ],
      "strategic": [
        { "db": "trajectory", "intent": "active visions", "limit": 5, "date_filter": false }
      ]
    }
  }
}
