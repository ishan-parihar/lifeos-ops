        "title": "Name",
        "entry_type": "Category",
        "status": "Status"
      }
    }
  },
  "briefings": {
    "roles": {
      "CEO": [
        { "db": "significator", "intent": "vision alignment", "limit": 5, "date_filter": false },
        { "db": "greatway", "intent": "active annual goals", "limit": 5, "date_filter": false }
      ],
      "COO": [
        { "db": "greatway", "intent": "active projects", "limit": 10, "date_filter": false },
        { "db": "matrix", "intent": "active practices", "limit": 10, "date_filter": false }
      ]
    },
    "modules": {
      "productivity": [
        { "db": "greatway", "intent": "active tasks", "limit": 20, "date_filter": true }
      ],
      "strategic": [
        { "db": "significator", "intent": "active visions", "limit": 5, "date_filter": false }
      ]
    }
  }
